{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "esModuleInterop": true,
    "paths": {
      "@Pool": [
        "./src/db/db.ts"
      ],
      "@InnerTypes/*": [
        "./src/types/*"
      ],
      "@routers/*": [
        "./src/routers/*"
      ],
      "@validation/*": [
        "./src/validation/*"
      ],
      "@modules/*": [
        "./src/modules/*"
      ],
      "@helpers/*": [
        "./src/helpers/*"
      ],
      "@middleware/*": [
        "./src/middleware/*",
      ]
    }
  }
}